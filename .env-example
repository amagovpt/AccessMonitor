# --- ENVIRONMENT INSTRUCTIONS ---
# 1. Copy this file and rename it based on your target environment:
#    - Local Development: .env.dev
#    - Pre-production/Staging: .env.preprod
#    - Production: .env.prod
# --- API CONFIGURATION ---
# Monitor Server AMP Endpoint 
REACT_APP_AMP_SERVER=

# Application Base Path (e.g., / or /amp)
REACT_APP_BASE_URL=/

# Data Strategy: 'remote' or 'local'
REACT_APP_API_DATA_SOURCE=remote

# --- DEV SETTINGS ---
# Port for local development 
PORT=3001